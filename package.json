{
  "name": "ark-sales",
  "version": "1.0.0",
  "type": "module",
  "description": "ARK Sales - Motor de adquisición agéntico y enrutamiento por dolor del ecosistema ARK",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"migrations/*.sql\" \"seed/**/*.sql\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "hono": "^4.6.14",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
